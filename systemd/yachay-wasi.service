[Unit]
Description=Yachay Wasi: Community Information Service (SMS Alerts)
After=gammu-smsd.service

[Service]
Type=simple
User=offlineagent
Group=offlineagent
WorkingDirectory=/opt/yachay-wasi
ExecStart=/usr/bin/python3 -m src.sms_bridge
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
